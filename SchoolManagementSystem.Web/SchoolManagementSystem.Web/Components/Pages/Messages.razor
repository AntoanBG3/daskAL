@page "/messages"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using SchoolManagementSystem.Web.Models
@using SchoolManagementSystem.Web.Models.ViewModels
@using SchoolManagementSystem.Web.Services
@using Microsoft.AspNetCore.Identity
@using SchoolManagementSystem.Web.Models.Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject IMessageService MessageService
@inject ITeacherService TeacherService
@inject NavigationManager NavigationManager
@inject UserManager<User> UserManager
@attribute [Authorize]

<PageTitle>Messages - daskAL</PageTitle>

<PageHeader Title="Messages"
            Icon="bi bi-envelope-fill"
            Subtitle="Threaded inbox with recipient preselection and an explicit compose state.">
    <Actions>
        <button class="btn btn-primary" @onclick='() => SetTab("compose")'>
            <i class="bi bi-pencil-square" aria-hidden="true"></i> New Message
        </button>
    </Actions>
</PageHeader>

@if (IsLoading)
{
    <LoadingState Message="Loading messages..." />
}
else
{
    <div class="message-workspace">
        <aside class="message-list-panel" aria-label="Message folders">
            <div class="message-list-header">
                <div class="message-tabs" role="tablist" aria-label="Message folder">
                    <button type="button" class="message-tab @(ActiveTab == "inbox" ? "active" : "")" @onclick='() => SetTab("inbox")'>Inbox</button>
                    <button type="button" class="message-tab @(ActiveTab == "sent" ? "active" : "")" @onclick='() => SetTab("sent")'>Sent</button>
                </div>
                <label for="message-search" class="visually-hidden">Search messages</label>
                <input id="message-search"
                       class="form-control"
                       placeholder="Search messages..."
                       @bind="MessageSearch"
                       @bind:event="oninput" />
            </div>

            <div class="message-list">
                @if (FilteredMessages.Any())
                {
                    @foreach (var msg in FilteredMessages)
                    {
                        var counterparty = GetCounterparty(msg);
                        <button type="button"
                                class="message-list-item @(SelectedMessageId == msg.Id ? "active" : "") @(!msg.IsRead && ActiveTab == "inbox" ? "unread" : "")"
                                @onclick="() => SelectMessage(msg.Id)">
                            <span class="message-list-item__top">
                                <span class="text-truncate">@counterparty</span>
                                <small>@msg.SentAt.ToLocalTime().ToString("MMM d")</small>
                            </span>
                            <span class="d-block text-truncate">@msg.Subject</span>
                            <span class="message-preview d-block text-truncate">@msg.Content</span>
                        </button>
                    }
                }
                else
                {
                    <EmptyState Icon="bi bi-inbox"
                                Title="No messages found"
                                Message="Try another folder or start a new message." />
                }
            </div>
        </aside>

        <section class="message-thread-panel" aria-label="Message details">
            @if (ActiveTab == "compose")
            {
                <div class="message-thread-header">
                    <div class="message-person">
                        <div class="message-avatar" aria-hidden="true">+</div>
                        <div>
                            <h2 class="h5 mb-1">New message</h2>
                            <p class="text-muted small mb-0">Choose a recipient and send a school message.</p>
                        </div>
                    </div>
                </div>

                <div class="message-compose-form">
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @ErrorMessage
                            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null" aria-label="Close"></button>
                        </div>
                    }

                    <div>
                        <label class="form-label fw-semibold" for="message-recipient">To</label>
                        <select id="message-recipient" class="form-select" @bind="NewMessageReceiverEmail">
                            <option value="">Select Recipient...</option>
                            @foreach (var recipient in AvailableRecipients)
                            {
                                <option value="@recipient.Email">@recipient.Name (@recipient.Role)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label fw-semibold" for="message-subject">Subject</label>
                        <input id="message-subject" type="text" class="form-control" @bind="NewMessageSubject" />
                    </div>
                    <div>
                        <label class="form-label fw-semibold" for="message-content">Message</label>
                        <textarea id="message-content" class="form-control" rows="8" @bind="NewMessageContent"></textarea>
                    </div>
                    <div class="d-flex gap-2 justify-content-end">
                        <button class="btn btn-outline" @onclick='() => SetTab("inbox")'>Cancel</button>
                        <button class="btn btn-primary" @onclick="SendMessage">
                            <i class="bi bi-send-fill" aria-hidden="true"></i> Send
                        </button>
                    </div>
                </div>
            }
            else if (SelectedMessage is not null)
            {
                var selected = SelectedMessage;
                <div class="message-thread-header">
                    <div class="message-person">
                        <div class="message-avatar" aria-hidden="true">@GetInitials(GetCounterparty(selected))</div>
                        <div>
                            <h2 class="h5 mb-1">@GetCounterparty(selected)</h2>
                            <p class="text-muted small mb-0">@selected.SentAt.ToLocalTime().ToString("f")</p>
                        </div>
                    </div>
                    @if (ActiveTab == "inbox" && !selected.IsRead)
                    {
                        <button class="btn btn-sm btn-outline" @onclick="() => MarkAsRead(selected.Id)">Mark read</button>
                    }
                </div>
                <div class="message-thread-body">
                    <div class="message-bubble">
                        <div class="text-muted small fw-semibold mb-2">@selected.Subject</div>
                        <p class="mb-0">@selected.Content</p>
                    </div>
                </div>
                <div class="message-composer">
                    <button class="btn btn-primary" @onclick='() => StartReply(selected)'>
                        <i class="bi bi-reply" aria-hidden="true"></i> Reply
                    </button>
                </div>
            }
            else
            {
                <EmptyState Icon="bi bi-chat-dots"
                            Title="Select a message"
                            Message="Choose a conversation from the list or create a new message." />
            }
        </section>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public string? ComposeTo { get; set; }

    private string ActiveTab = "inbox";
    private bool IsLoading = true;
    private string CurrentUserId = "";
    private string MessageSearch = "";
    private int? SelectedMessageId;
    
    private List<Message> InboxMessages = new();
    private List<Message> SentMessages = new();
    
    // Compose Form
    private string NewMessageReceiverEmail = "";
    private string NewMessageSubject = "";
    private string NewMessageContent = "";
    
    private List<RecipientOption> AvailableRecipients = new();

    private IEnumerable<Message> CurrentMessages => ActiveTab == "sent" ? SentMessages : InboxMessages;

    private IEnumerable<Message> FilteredMessages
    {
        get
        {
            var messages = CurrentMessages;
            if (!string.IsNullOrWhiteSpace(MessageSearch))
            {
                messages = messages.Where(m =>
                    m.Subject.Contains(MessageSearch, StringComparison.OrdinalIgnoreCase) ||
                    m.Content.Contains(MessageSearch, StringComparison.OrdinalIgnoreCase) ||
                    GetCounterparty(m).Contains(MessageSearch, StringComparison.OrdinalIgnoreCase));
            }

            return messages;
        }
    }

    private Message? SelectedMessage => CurrentMessages.FirstOrDefault(m => m.Id == SelectedMessageId);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            CurrentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
            
            if (!string.IsNullOrEmpty(CurrentUserId))
            {
                await LoadMessages();
                await LoadRecipients(user);
            }
        }
        
        if (!string.IsNullOrEmpty(ComposeTo))
        {
             SetTab("compose");
        }
        else
        {
            SelectFirstAvailableMessage();
        }
        
        IsLoading = false;
    }

    private async Task LoadMessages()
    {
        InboxMessages = await MessageService.GetMessagesForUserAsync(CurrentUserId);
        SentMessages = await MessageService.GetSentMessagesAsync(CurrentUserId);
        if (ActiveTab != "compose" && SelectedMessageId is null)
        {
            SelectFirstAvailableMessage();
        }
    }

    private async Task LoadRecipients(ClaimsPrincipal currentUser)
    {
        AvailableRecipients.Clear();
        
        // Get all users in relevant roles
        var admins = await UserManager.GetUsersInRoleAsync("Admin");
        var teachers = await UserManager.GetUsersInRoleAsync("Teacher");
        var students = await UserManager.GetUsersInRoleAsync("Student");
        
        foreach(var u in admins)
            AvailableRecipients.Add(new RecipientOption { Name = $"{u.FirstName} {u.LastName}", Email = u.Email!, Role = "Admin" });
            
        foreach(var u in teachers)
            AvailableRecipients.Add(new RecipientOption { Name = $"{u.FirstName} {u.LastName}", Email = u.Email!, Role = "Teacher" });
            
        // If I am a teacher, I can message students
        if (currentUser.IsInRole("Teacher") || currentUser.IsInRole("Admin"))
        {
             foreach(var u in students)
                AvailableRecipients.Add(new RecipientOption { Name = $"{u.FirstName} {u.LastName}", Email = u.Email!, Role = "Student" });
        }
        
        // Handle ComposeTo Pre-selection
        if (!string.IsNullOrEmpty(ComposeTo) && int.TryParse(ComposeTo, out int teacherId))
        {
             // We have Teacher ID. We need to select the email.
             // We can fetch the Teacher Entity to get the UserId, then match.
             // But we don't have access to Teacher Entity here easily without a new Service method.
             // HACK: Match by Name from Teacher Service?
             var teacherVM = await TeacherService.GetTeacherByIdAsync(teacherId);
             if (teacherVM != null)
             {
                 var match = AvailableRecipients.FirstOrDefault(r => r.Name == teacherVM.FullName && r.Role == "Teacher");
                 if (match != null) NewMessageReceiverEmail = match.Email;
             }
        }
    }

    private void SetTab(string tab)
    {
        ActiveTab = tab;
        ErrorMessage = null;
        if (tab != "compose")
        {
            SelectFirstAvailableMessage();
        }
    }

    private void SelectMessage(int id)
    {
        SelectedMessageId = id;
        if (ActiveTab == "compose")
        {
            ActiveTab = "inbox";
        }
    }

    private void SelectFirstAvailableMessage()
    {
        SelectedMessageId = CurrentMessages.FirstOrDefault()?.Id;
    }

    private async Task MarkAsRead(int id)
    {
        await MessageService.MarkMessageAsReadAsync(id);
        await LoadMessages();
    }

    private void StartReply(Message message)
    {
        var recipient = ActiveTab == "sent" ? message.Receiver : message.Sender;
        NewMessageReceiverEmail = recipient?.Email ?? "";
        NewMessageSubject = message.Subject.StartsWith("Re:", StringComparison.OrdinalIgnoreCase)
            ? message.Subject
            : $"Re: {message.Subject}";
        NewMessageContent = "";
        SetTab("compose");
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(NewMessageReceiverEmail) || string.IsNullOrWhiteSpace(NewMessageContent)) return;

        try 
        {
            await MessageService.SendMessageAsync(CurrentUserId, NewMessageReceiverEmail, NewMessageSubject, NewMessageContent);
            NewMessageSubject = "";
            NewMessageContent = "";
            NewMessageReceiverEmail = "";
            SetTab("sent");
            await LoadMessages();
            SelectFirstAvailableMessage();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error sending message: {ex.Message}";
        }
    }

    private string? ErrorMessage;

    private string GetCounterparty(Message message)
    {
        var user = ActiveTab == "sent" ? message.Receiver : message.Sender;
        return GetDisplayName(user);
    }

    private static string GetDisplayName(User? user)
    {
        if (user is null)
        {
            return "Unknown user";
        }

        var name = $"{user.FirstName} {user.LastName}".Trim();
        return string.IsNullOrWhiteSpace(name) ? user.Email ?? "Unknown user" : name;
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "?";
        }

        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
    
    public class RecipientOption
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
    }
}
