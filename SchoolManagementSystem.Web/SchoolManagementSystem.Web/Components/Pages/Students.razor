@page "/students"
@attribute [Authorize(Roles = "Admin,Teacher")]
@inject IStudentService StudentService
@using SchoolManagementSystem.Web.Models.ViewModels

<PageTitle>Students - daskAL</PageTitle>

<PageHeader Title="Students"
            Icon="bi bi-people"
            Subtitle="Search, filter, edit, and message students from one table.">
    <Actions>
        <a href="students/add" class="btn btn-primary">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Student
        </a>
    </Actions>
</PageHeader>

<div class="filters-toolbar ui-panel">
    <div class="form-group is-wide">
        <label for="student-search">Search</label>
        <input id="student-search"
               class="form-control"
               placeholder="Search by student name..."
               @bind="SearchTerm"
               @bind:event="oninput" />
    </div>
    <div class="form-group">
        <label for="class-filter">Class</label>
        <select id="class-filter" class="form-select" @bind="SelectedClass">
            <option value="">All classes</option>
            @foreach (var className in ClassOptions)
            {
                <option value="@className">@className</option>
            }
        </select>
    </div>
    <button type="button" class="btn btn-outline" @onclick="ClearFilters">
        <i class="bi bi-x-lg" aria-hidden="true"></i> Reset
    </button>
    <a href="students/add" class="btn btn-primary">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Student
    </a>
</div>

@if (students == null)
{
    <LoadingState Message="Loading students..." />
}
else if (!FilteredStudents.Any())
{
    <EmptyState Icon="bi bi-people"
                Title="No students match the current filters"
                Message="Reset filters or add a new student.">
        <button type="button" class="btn btn-outline" @onclick="ClearFilters">Reset filters</button>
        <a href="students/add" class="btn btn-primary">Add student</a>
    </EmptyState>
}
else
{
    <div class="card-table">
        <div class="table-responsive">
            <table class="table table-modern mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Class</th>
                        <th>Date of Birth</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in FilteredStudents)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@student.FirstName @student.LastName</td>
                            <td>
                                @if (!string.IsNullOrEmpty(student.Class))
                                {
                                    <span class="badge-subject">@student.Class</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Unassigned</span>
                                }
                            </td>
                            <td>@student.DateOfBirth.ToShortDateString()</td>
                            <td class="text-end pe-4">
                                <div class="row-actions">
                                    <a href="/students/edit/@student.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-fill" aria-hidden="true"></i> Edit
                                    </a>
                                    <a href="/messages" class="btn btn-sm btn-outline">
                                        <i class="bi bi-chat-dots" aria-hidden="true"></i> Message
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RequestDelete(student)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                        <span class="visually-hidden">Delete @student.FullName</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<ConfirmDialog IsOpen="StudentPendingDelete is not null"
               Title="Delete student"
               Message="@DeleteMessage"
               ConfirmText="Delete"
               ConfirmButtonClass="btn-danger"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />

@code {
    private List<StudentViewModel>? students;
    private string SearchTerm = "";
    private string SelectedClass = "";
    private StudentViewModel? StudentPendingDelete;

    private IEnumerable<string> ClassOptions => students?
        .Select(s => s.Class)
        .Where(c => !string.IsNullOrWhiteSpace(c))
        .Distinct()
        .OrderBy(c => c) ?? Enumerable.Empty<string>();

    private IEnumerable<StudentViewModel> FilteredStudents
    {
        get
        {
            var query = students ?? Enumerable.Empty<StudentViewModel>();

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                query = query.Where(s => s.FullName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(SelectedClass))
            {
                query = query.Where(s => s.Class == SelectedClass);
            }

            return query;
        }
    }

    private string DeleteMessage => StudentPendingDelete is null
        ? string.Empty
        : $"This will permanently remove {StudentPendingDelete.FullName}. This action cannot be undone.";

    protected override async Task OnInitializedAsync()
    {
        await LoadStudents();
    }

    private async Task LoadStudents()
    {
        students = await StudentService.GetAllStudentsAsync();
    }

    private void ClearFilters()
    {
        SearchTerm = "";
        SelectedClass = "";
    }

    private void RequestDelete(StudentViewModel student)
    {
        StudentPendingDelete = student;
    }

    private void CancelDelete()
    {
        StudentPendingDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (StudentPendingDelete is null)
        {
            return;
        }

        await StudentService.DeleteStudentAsync(StudentPendingDelete.Id);
        StudentPendingDelete = null;
        await LoadStudents();
    }
}
