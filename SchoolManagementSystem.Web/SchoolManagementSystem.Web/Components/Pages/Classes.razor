@page "/classes"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IClassService ClassService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using SchoolManagementSystem.Web.Models.ViewModels

<PageTitle>Classes - daskAL</PageTitle>

<PageHeader Title="School Classes"
            Icon="bi bi-building"
            Subtitle="Manage classes and their subject assignments.">
    <Actions>
        <a href="classes/add" class="btn btn-primary">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add New Class
        </a>
    </Actions>
</PageHeader>

@if (classes == null)
{
    <LoadingState Message="Loading classes..." />
}
else if (!classes.Any())
{
    <EmptyState Icon="bi bi-building"
                Title="No classes found"
                Message="Create a class before assigning subjects.">
        <a href="classes/add" class="btn btn-primary">Add New Class</a>
    </EmptyState>
}
else
{
    <div class="card-table">
        <div class="table-responsive">
            <table class="table table-modern mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Assigned Subjects</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in classes)
                    {
                        <tr>
                            <td class="ps-4 align-middle fw-bold">@c.Name</td>
                            <td class="align-middle">
                                @if(c.AssignedSubjects.Any())
                                {
                                    @foreach(var subject in c.AssignedSubjects)
                                    {
                                        <span class="badge-subject">@subject</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">No subjects assigned</span>
                                }
                            </td>
                            <td class="text-end pe-4 align-middle">
                                <div class="row-actions">
                                    <a href="classes/edit/@c.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-fill" aria-hidden="true"></i> Manage
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<SchoolClassViewModel>? classes;

    protected override async Task OnInitializedAsync()
    {
        classes = await ClassService.GetAllClassesAsync();
    }
}
