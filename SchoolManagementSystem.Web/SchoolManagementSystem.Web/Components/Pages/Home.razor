@page "/"
@using Microsoft.AspNetCore.Authorization
@using SchoolManagementSystem.Web.Services
@using SchoolManagementSystem.Web.Models
@using SchoolManagementSystem.Web.Models.ViewModels
@using SchoolManagementSystem.Web.Data
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject IStudentService StudentService
@inject ITeacherService TeacherService
@inject IClassService ClassService
@inject IAbsenceService AbsenceService
@inject IGradeService GradeService
@inject IScheduleService ScheduleService
@inject IMessageService MessageService
@inject SchoolDbContext DbContext
@inject IJSRuntime JSRuntime
@inject ILogger<Home> Logger

<PageTitle>Dashboard - daskAL</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="dashboard-header">
            <div>
                <h1>
                    @Greeting, <span class="text-gradient">@context.User.Identity?.Name</span>
                </h1>
                <p class="text-muted mb-0">Here's what's happening at your school today.</p>
            </div>
            <div class="d-none d-md-block">
                <span class="text-muted small">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>

        <AuthorizeView Roles="Admin" Context="adminContext">
            <div class="admin-dashboard-grid">
                <div class="card-premium metric-card grid-span-1">
                    <div class="metric-card__top">
                        <div class="card-icon" style="background: var(--primary-soft); color: var(--primary);">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <span class="stat-label">Students</span>
                    </div>
                    <h2 class="stat-value">@TotalStudents</h2>
                    <p class="metric-card__meta">Active students</p>
                </div>

                <div class="card-premium metric-card grid-span-1">
                    <div class="metric-card__top">
                        <div class="card-icon" style="background: var(--warning-soft); color: var(--warning);">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                        <span class="stat-label">Teachers</span>
                    </div>
                    <h2 class="stat-value">@TotalTeachers</h2>
                    <p class="metric-card__meta">Teaching staff</p>
                </div>

                <div class="card-premium metric-card grid-span-1">
                    <div class="metric-card__top">
                        <div class="card-icon" style="background: #DBEAFE; color: #2563EB;">
                            <i class="bi bi-building"></i>
                        </div>
                        <span class="stat-label">Classes</span>
                    </div>
                    <h2 class="stat-value">@TotalClasses</h2>
                    <p class="metric-card__meta">Configured classes</p>
                </div>

                <div class="card-premium metric-card grid-span-1">
                    <div class="metric-card__top">
                        <div class="card-icon" style="background: var(--danger-soft); color: var(--danger);">
                            <i class="bi bi-calendar-x"></i>
                        </div>
                        <span class="stat-label">Absences</span>
                    </div>
                    <h2 class="stat-value">@RecentAbsences.Sum(a => a.Count)</h2>
                    <p class="metric-card__meta">Recorded in the last 7 days</p>
                </div>
            </div>

            <div class="dashboard-panels">
                <div class="card-premium">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Attendance Overview</h5>
                        <span class="badge-soft">Last 7 days</span>
                    </div>
                    <div class="flex-grow-1 d-flex align-items-end justify-content-center bg-light rounded-3 p-3 position-relative overflow-hidden" style="min-height: 260px;">
                        <div class="d-flex justify-content-around w-100 h-100 align-items-end" style="gap: 8px;">
                            @foreach (var day in RecentAbsences)
                            {
                                var height = MaxAbsences > 0 ? (day.Count * 100 / MaxAbsences) : 0;
                                var displayHeight = Math.Max(5, Math.Min(95, height));

                                <div class="d-flex flex-column align-items-center" style="width: 12%; height: 100%; justify-content: flex-end;">
                                    <div style="width: 100%; height: @displayHeight%; background: var(--primary); border-radius: 8px 8px 0 0; box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2);"
                                         title="@day.Date.ToString("ddd"): @day.Count absences"></div>
                                    <small class="mt-1 text-muted" style="font-size: 0.7rem;">@day.Date.ToString("ddd")</small>
                                </div>
                            }
                            @if (RecentAbsences.Count == 0)
                            {
                                <div class="d-flex align-items-center justify-content-center w-100 h-100 text-muted">
                                    No absence data for the last week.
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-premium">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Operational shortcuts</h5>
                        <span class="text-muted small">@DateTime.Now.ToString("MMM dd")</span>
                    </div>
                    <div class="activity-list">
                        <a href="students" class="activity-item text-decoration-none">
                            <span class="activity-dot"></span>
                            <span class="fw-semibold text-dark">Manage students</span>
                            <span class="ms-auto text-muted small">@TotalStudents total</span>
                        </a>
                        <a href="teachers" class="activity-item text-decoration-none">
                            <span class="activity-dot" style="background: var(--warning);"></span>
                            <span class="fw-semibold text-dark">Review teachers</span>
                            <span class="ms-auto text-muted small">@TotalTeachers total</span>
                        </a>
                        <a href="classes" class="activity-item text-decoration-none">
                            <span class="activity-dot" style="background: var(--success);"></span>
                            <span class="fw-semibold text-dark">Update classes</span>
                            <span class="ms-auto text-muted small">@TotalClasses total</span>
                        </a>
                        <a href="messages" class="activity-item text-decoration-none">
                            <span class="activity-dot" style="background: var(--info);"></span>
                            <span class="fw-semibold text-dark">Open messages</span>
                            <span class="ms-auto text-muted small">Inbox</span>
                        </a>
                    </div>
                </div>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="Teacher" Context="teacherContext">
            <div class="bento-grid">
                <div class="card-premium" style="grid-column: span 2;">
                    <div class="d-flex align-items-center mb-3">
                        <div class="card-icon me-3" style="background: #DCFCE7; color: #16A34A;">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div>
                            <h5 class="card-title mb-0">Teacher Portal</h5>
                            <p class="text-muted small mb-0">Manage your classes and students</p>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a href="grades" class="btn btn-primary w-100 py-3">
                                <i class="bi bi-clipboard-data me-2"></i> Manage Grades
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="messages" class="btn btn-outline w-100 py-3">
                                <i class="bi bi-envelope me-2"></i> Messages
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-premium">
                    <h5 class="card-title">Recent Updates</h5>
                    <p class="text-muted small">No new notifications.</p>
                </div>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="Student" Context="studentContext">
            @if (StudentIsLoading)
            {
                <div class="spinner-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading…</span>
                    </div>
                </div>
            }
            else
            {
                <!-- Stats Row -->
                <div class="student-stats-row">
                    <div class="student-stat-card">
                        <div class="stat-icon-box" style="background: #EEF2FF; color: #4F46E5;">
                            <i class="bi bi-graph-up fs-5"></i>
                        </div>
                        <div>
                            <div class="stat-meta-label">Overall Average</div>
                            <div class="stat-value-serif">@StudentOverallAvg.ToString("F2")</div>
                            <div class="stat-hint @GetGradeTrendClass(StudentOverallAvg)">@GetGradeLabel(StudentOverallAvg)</div>
                        </div>
                    </div>

                    <div class="student-stat-card">
                        <div class="stat-icon-box" style="background: @(StudentAbsences.Any(a => !a.IsExcused) ? "#FEE2E2" : "#DCFCE7"); color: @(StudentAbsences.Any(a => !a.IsExcused) ? "#DC2626" : "#059669");">
                            <i class="bi bi-calendar-check fs-5"></i>
                        </div>
                        <div>
                            <div class="stat-meta-label">Absences</div>
                            <div class="stat-value-serif">@StudentAbsences.Count</div>
                            <div class="stat-hint">@StudentAbsences.Count(a => !a.IsExcused) unexcused</div>
                        </div>
                    </div>

                    <div class="student-stat-card">
                        <div class="stat-icon-box" style="background: #CFFAFE; color: #0891B2;">
                            <i class="bi bi-envelope fs-5"></i>
                        </div>
                        <div>
                            <div class="stat-meta-label">Messages</div>
                            <div class="stat-value-serif">@StudentUnreadMessages</div>
                            <div class="stat-hint">unread</div>
                        </div>
                    </div>
                </div>

                <!-- Subject Grades -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="mb-0 fw-semibold d-flex align-items-center gap-2">
                        <i class="bi bi-journal-bookmark text-primary"></i>
                        Subject Grades
                    </h5>
                    <a href="my-grades" class="small fw-semibold text-primary text-decoration-none">Full Report →</a>
                </div>

                @if (StudentGradesBySubject.Any())
                {
                    <div class="subject-grades-grid">
                        @{ int subjectIdx = 0; }
                        @foreach (var group in StudentGradesBySubject)
                        {
                            var avg = group.Average(g => (double)g.Value);
                            var vals = group.Select(g => (double)g.Value).ToList();
                            var trend = GetGradeTrend(vals);
                            var colorClass = GetGradeColorClass(avg);
                            var cp = SubjectColorPalette[subjectIdx % SubjectColorPalette.Length];
                            var sparkSvg = GenerateSparkLine(vals, cp.Color, subjectIdx);
                            subjectIdx++;

                            <div class="subject-grade-card @colorClass">
                                <div class="subject-card-header">
                                    <div class="subject-icon" style="background: @cp.Bg; color: @cp.Color;">
                                        <i class="@GetSubjectIcon(group.Key)"></i>
                                    </div>
                                    <div class="subject-name-label">@group.Key</div>
                                </div>

                                <div class="grade-meta-row">
                                    <div class="grade-num-display @colorClass">@avg.ToString("F2")</div>
                                    @if (vals.Count >= 2)
                                    {
                                        <div class="grade-trend-pill @(trend > 0.05 ? "up" : trend < -0.05 ? "down" : "flat")">
                                            @(trend > 0.05 ? "↑" : trend < -0.05 ? "↓" : "→") @Math.Abs(trend).ToString("F1")
                                        </div>
                                    }
                                </div>

                                <div class="grade-label-text mb-2">
                                    @GetGradeLabel(avg) · @group.Count() @(group.Count() == 1 ? "grade" : "grades")
                                </div>

                                @if (vals.Count >= 2)
                                {
                                    <div class="sparkline-wrap">
                                        @((MarkupString)sparkSvg)
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i> No grades recorded yet. Check back after your first assessments.
                    </div>
                }

                <!-- Bottom Grid: Schedule + Attendance -->
                <div class="student-bottom-grid">

                    <!-- Today's Schedule -->
                    <div class="card-table">
                        <div class="card-table-header">
                            <h5><i class="bi bi-calendar3"></i> Today's Schedule</h5>
                            <span class="small text-muted">@DateTime.Now.ToString("ddd, MMM d")</span>
                        </div>
                        @if (StudentTodaySchedule.Any())
                        {
                            @foreach (var entry in StudentTodaySchedule)
                            {
                                var isNext = NextClassToday != null && entry.Id == NextClassToday.Id;
                                <div class="schedule-entry @(isNext ? "is-next" : "")">
                                    <div class="schedule-time-col">
                                        @entry.StartTime.ToString(@"hh\:mm")
                                    </div>
                                    <div>
                                        <div class="schedule-subject-name">
                                            @(entry.ClassSubject?.Subject?.Name ?? "Class")
                                            @if (isNext) { <span class="next-badge">NEXT</span> }
                                        </div>
                                        <div class="schedule-room-text">
                                            @(string.IsNullOrEmpty(entry.RoomNumber) ? "—" : entry.RoomNumber)
                                            · ends @entry.EndTime.ToString(@"hh\:mm")
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state py-4">
                                <i class="bi bi-calendar-event"></i>
                                <h5>No classes today</h5>
                                <p>Nothing scheduled — enjoy your time!</p>
                            </div>
                        }
                    </div>

                    <!-- Attendance Summary -->
                    <div class="card-table">
                        <div class="card-table-header">
                            <h5><i class="bi bi-calendar-check"></i> Attendance</h5>
                            <a href="my-grades" class="small text-primary text-decoration-none">Details →</a>
                        </div>

                        @{
                            var excused = StudentAbsences.Count(a => a.IsExcused);
                            var unexcused = StudentAbsences.Count(a => !a.IsExcused);
                        }

                        <div class="absence-summary">
                            <span class="text-secondary small">Total Absences</span>
                            <span class="fw-semibold">@StudentAbsences.Count</span>
                        </div>
                        <div class="absence-summary">
                            <span class="text-secondary small">Excused</span>
                            <span class="badge bg-success">@excused</span>
                        </div>
                        <div class="absence-summary">
                            <span class="text-secondary small">Unexcused</span>
                            <span class="badge @(unexcused > 0 ? "bg-danger" : "bg-secondary")">@unexcused</span>
                        </div>

                        @if (!StudentAbsences.Any())
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-patch-check-fill text-success" style="font-size: 2rem;"></i>
                                <p class="small text-muted mt-2 mb-0">Perfect attendance!</p>
                            </div>
                        }

                        <div class="p-3 border-top border-light">
                            <a href="my-grades" class="btn btn-outline w-100 btn-sm">
                                <i class="bi bi-list-check me-1"></i> View Full Record
                            </a>
                        </div>
                    </div>

                </div>
            }
        </AuthorizeView>

    </Authorized>
</AuthorizeView>



@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }

    private string Greeting = "Good Morning";

    // ---- Admin data ----
    private int TotalStudents;
    private int TotalTeachers;
    private int TotalClasses;
    private List<DailyAbsenceStat> RecentAbsences = new();
    private int MaxAbsences = 1;

    // ---- Student data ----
    private bool StudentIsLoading = true;
    private List<IGrouping<string, GradeViewModel>> StudentGradesBySubject = new();
    private double StudentOverallAvg = 0;
    private List<Absence> StudentAbsences = new();
    private List<ScheduleEntry> StudentTodaySchedule = new();
    private ScheduleEntry? NextClassToday;
    private int StudentUnreadMessages = 0;

    private static readonly (string Color, string Bg)[] SubjectColorPalette =
    {
        ("#4F46E5", "#EEF2FF"),
        ("#0891B2", "#CFFAFE"),
        ("#059669", "#DCFCE7"),
        ("#D97706", "#FEF3C7"),
        ("#7C3AED", "#EDE9FE"),
        ("#0F766E", "#CCFBF1"),
        ("#DC2626", "#FEE2E2"),
        ("#9333EA", "#F3E8FF"),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var hour = await JSRuntime.InvokeAsync<int>("getClientHour");
                Greeting = hour switch
                {
                    >= 5 and < 12 => "Good Morning",
                    >= 12 and < 18 => "Good Afternoon",
                    _ => "Good Evening"
                };
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Unable to determine client-local greeting time.");
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (authenticationStateTask is null)
        {
            Logger.LogWarning("Authentication state was not available for the dashboard.");
            return;
        }

        var authState = await authenticationStateTask;
        var user = authState.User;

        if (user.IsInRole("Admin"))
        {
            await LoadAdminStats();
        }
        else if (user.IsInRole("Student"))
        {
            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            await LoadStudentStats(userId);
        }
    }

    private async Task LoadAdminStats()
    {
        var allStudents = await StudentService.GetAllStudentsAsync();
        TotalStudents = allStudents.Count;

        var allTeachers = await TeacherService.GetAllTeachersAsync();
        TotalTeachers = allTeachers.Count;

        var allClasses = await ClassService.GetAllClassesAsync();
        TotalClasses = allClasses.Count;

        var sevenDaysAgo = DateTime.Today.AddDays(-6);
        var absences = await DbContext.Absences
            .Where(a => a.Date >= sevenDaysAgo)
            .ToListAsync();

        var grouped = absences
            .GroupBy(a => a.Date.Date)
            .Select(g => new DailyAbsenceStat { Date = g.Key, Count = g.Count() })
            .ToList();

        for (int i = 0; i < 7; i++)
        {
            var date = sevenDaysAgo.AddDays(i);
            if (!grouped.Any(d => d.Date == date))
                grouped.Add(new DailyAbsenceStat { Date = date, Count = 0 });
        }

        RecentAbsences = grouped.OrderBy(d => d.Date).ToList();
        if (RecentAbsences.Any())
        {
            MaxAbsences = RecentAbsences.Max(d => d.Count);
            if (MaxAbsences == 0) MaxAbsences = 1;
        }
    }

    private async Task LoadStudentStats(string? userId)
    {
        if (string.IsNullOrEmpty(userId)) { StudentIsLoading = false; return; }
        try
        {
            var student = await StudentService.GetStudentByUserIdAsync(userId);
            if (student != null)
            {
                var grades = await GradeService.GetGradesForStudentAsync(student.Id);
                StudentGradesBySubject = grades.GroupBy(g => g.SubjectName).ToList();
                StudentOverallAvg = grades.Any() ? grades.Average(g => (double)g.Value) : 0;

                StudentAbsences = await AbsenceService.GetAbsencesForStudentAsync(student.Id);

                if (student.SchoolClassId.HasValue)
                {
                    var allSchedule = await ScheduleService.GetScheduleForClassAsync(student.SchoolClassId.Value);
                    var today = DateTime.Now.DayOfWeek;
                    StudentTodaySchedule = allSchedule
                        .Where(e => e.DayOfWeek == today)
                        .OrderBy(e => e.StartTime)
                        .ToList();
                    var now = DateTime.Now.TimeOfDay;
                    NextClassToday = StudentTodaySchedule.FirstOrDefault(e => e.StartTime > now);
                }

                var messages = await MessageService.GetMessagesForUserAsync(userId);
                StudentUnreadMessages = messages.Count(m => !m.IsRead);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load student dashboard data for user {UserId}", userId);
        }
        finally { StudentIsLoading = false; }
    }

    // ---- Grade helpers ----

    private static string GetGradeLabel(double value) => value switch
    {
        >= 5.50 => "Excellent",
        >= 4.50 => "Very Good",
        >= 3.50 => "Good",
        >= 3.00 => "Average",
        _ => "Poor"
    };

    private static string GetGradeColorClass(double value) => value switch
    {
        >= 5.50 => "grade-excellent",
        >= 4.50 => "grade-good",
        >= 3.50 => "grade-average",
        _ => "grade-poor"
    };

    private static string GetGradeTrendClass(double value) => value switch
    {
        >= 4.50 => "text-success",
        >= 3.50 => "text-warning",
        _ => "text-danger"
    };

    private static double GetGradeTrend(List<double> values)
    {
        if (values.Count < 2) return 0;
        var half = Math.Max(1, values.Count / 2);
        var first = values.Take(half).Average();
        var second = values.Skip(half).Average();
        return second - first;
    }

    private static string GetSubjectIcon(string subjectName)
    {
        var n = subjectName.ToLowerInvariant();
        if (n.Contains("math") || n.Contains("матем")) return "bi bi-calculator";
        if (n.Contains("phys") || n.Contains("физик"))  return "bi bi-lightning-charge";
        if (n.Contains("chem") || n.Contains("хими"))   return "bi bi-flask";
        if (n.Contains("bio")  || n.Contains("биол"))   return "bi bi-heart-pulse";
        if (n.Contains("hist") || n.Contains("истор"))  return "bi bi-hourglass-split";
        if (n.Contains("eng")  || n.Contains("lit") || n.Contains("език")) return "bi bi-pen";
        if (n.Contains("comp") || n.Contains("info") || n.Contains("програм")) return "bi bi-code-slash";
        if (n.Contains("geo")  || n.Contains("геог"))   return "bi bi-globe2";
        if (n.Contains("art")  || n.Contains("изобраз")) return "bi bi-palette";
        if (n.Contains("music") || n.Contains("музик")) return "bi bi-music-note-beamed";
        if (n.Contains("sport") || n.Contains("физкулт")) return "bi bi-trophy";
        return "bi bi-book";
    }

    // ---- SVG Sparkline ----

    private static string GenerateSparkLine(List<double> values, string color, int index)
    {
        if (values.Count < 2) return "";

        const double w = 100, h = 32;
        var min = values.Min();
        var max = values.Max();
        var range = max - min == 0 ? 1.0 : max - min;
        var ic = System.Globalization.CultureInfo.InvariantCulture;

        var pts = values.Select((v, i) => new
        {
            x = i / (double)(values.Count - 1) * w,
            y = h - ((v - min) / range) * (h * 0.75) - h * 0.1
        }).ToList();

        string F(double d) => d.ToString("F1", ic);

        var sb = new System.Text.StringBuilder();
        sb.Append("M ").Append(F(pts[0].x)).Append(',').Append(F(pts[0].y));
        for (int i = 0; i < pts.Count - 1; i++)
        {
            var cpx = pts[i].x + (pts[i + 1].x - pts[i].x) / 2.0;
            sb.Append(" C ")
              .Append(F(cpx)).Append(',').Append(F(pts[i].y))
              .Append(' ')
              .Append(F(cpx)).Append(',').Append(F(pts[i + 1].y))
              .Append(' ')
              .Append(F(pts[i + 1].x)).Append(',').Append(F(pts[i + 1].y));
        }

        var linePath = sb.ToString();
        var fillPath = $"{linePath} L {F(pts.Last().x)},{F(h)} L {F(pts.First().x)},{F(h)} Z";
        var gradId = $"spkgrad{index}";

        return
            $"<svg viewBox=\"0 0 100 32\" preserveAspectRatio=\"none\" style=\"width:100%;height:100%;overflow:visible;\">" +
            $"<defs><linearGradient id=\"{gradId}\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">" +
            $"<stop offset=\"0%\" stop-color=\"{color}\" stop-opacity=\"0.18\"/>" +
            $"<stop offset=\"100%\" stop-color=\"{color}\" stop-opacity=\"0\"/>" +
            $"</linearGradient></defs>" +
            $"<path d=\"{fillPath}\" fill=\"url(#{gradId})\"/>" +
            $"<path d=\"{linePath}\" fill=\"none\" stroke=\"{color}\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>" +
            $"<circle cx=\"{F(pts.Last().x)}\" cy=\"{F(pts.Last().y)}\" r=\"2.5\" fill=\"{color}\"/>" +
            "</svg>";
    }

    public class DailyAbsenceStat
    {
        public DateTime Date { get; set; }
        public int Count { get; set; }
    }
}
